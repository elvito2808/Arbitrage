# Start and resume must be authorized through arbitrage-ctl.
[Unit]
Description=Arbitrage simulation (recover authorized session)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=exec
User=arbitrage
Group=arbitrage
StateDirectory=arbitrage
StateDirectoryMode=0700
WorkingDirectory=/var/lib/arbitrage
UMask=0077
EnvironmentFile=-/opt/arbitrage/service.env
Environment=PYTHONUTF8=1
ExecStart=/opt/arbitrage/current/venv/bin/python /opt/arbitrage/current/deploy/managed.py /var/lib/arbitrage recover
Restart=on-abnormal
RestartSec=10s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
